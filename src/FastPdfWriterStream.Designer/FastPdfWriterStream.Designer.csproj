<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <PackageId>FastPdfWriterStream.Designer</PackageId>
    <Version>1.0.0</Version>
    <Authors>GholamReza Khalaji</Authors>
    <Company>Bsi</Company>
    <Copyright>Copyright © 2026 GholamReza Khalaji</Copyright>
    <Title>FastPdfWriterStream.Designer — Visual PDF template designer for ASP.NET Core</Title>
    <Description>
      Visual (WYSIWYG, RTL/Persian) report template designer for FastPdfWriterStream, hosted inside any
      ASP.NET Core app with one line: app.MapFastPdfDesigner("/pdf-designer"). No external dependencies (works offline).
    </Description>
    <PackageTags>pdf;report;designer;template;persian;rtl;aspnetcore</PackageTags>
    <PackageProjectUrl>https://github.com/GhrezaKh74/Fastpdf</PackageProjectUrl>
    <RepositoryUrl>https://github.com/GhrezaKh74/Fastpdf</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FastPdfWriterStream\FastPdfWriterStream.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="wwwroot\**\*" LogicalName="FastPdfDesigner.%(Filename)%(Extension)" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
